@@ -0,0 +1,26 @@
+import { describe, expect, it } from 'vitest';
+import { validateWorkspaceId, validateWorkspaceUrl } from '@/process/services/agas/workspacePolicy';
+
+describe('native workspace policy', () => {
+  it('accepts an explicit loopback application address', () => {
+    expect(validateWorkspaceUrl('http://127.0.0.1:3100/')).toBe('http://127.0.0.1:3100/');
+    expect(validateWorkspaceUrl('http://[::1]:3000/')).toBe('http://[::1]:3000/');
+  });
+
+  it.each([
+    'https://example.com/',
+    'http://192.168.1.2:3100/',
+    'file:///etc/passwd',
+    'http://user:secret@localhost:3100/',
+    'http://localhost:3100/?token=secret',
+    'http://localhost:3100/#private',
+    'http://127.0.0.1.evil.test:3100/',
+  ])('rejects a nonlocal or credential-bearing address: %s', (address) => {
+    expect(() => validateWorkspaceUrl(address)).toThrow();
+  });
+
+  it('accepts only known application identifiers', () => {
+    expect(() => validateWorkspaceId('paperclip')).not.toThrow();
+    expect(() => validateWorkspaceId('other-app')).toThrow('Unknown native workspace');
+  });
+});
