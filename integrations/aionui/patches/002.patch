diff --git a/packages/desktop/src/renderer/pages/AgentWorkspace/AgencyCatalog.tsx b/packages/desktop/src/renderer/pages/AgentWorkspace/AgencyCatalog.tsx
new file mode 100644
index 0000000..3aff90d
--- /dev/null
