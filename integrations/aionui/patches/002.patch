diff --git a/packages/desktop/src/renderer/services/agency/createAssistant.ts b/packages/desktop/src/renderer/services/agency/createAssistant.ts
new file mode 100644
index 0000000..5db37e1
--- /dev/null
+++ b/packages/desktop/src/renderer/services/agency/createAssistant.ts
@@ -0,0 +1,48 @@
+import { ipcBridge } from '@/common';
+
+export type AgencyAssistantPersona = {
+  slug: string;
+  name: string;
+  description: string;
+  body: string;
+};
+
+/** Persist the original Agency instructions in the real AionCore assistant rule store. */
+export async function createAgencyAssistant(
+  persona: AgencyAssistantPersona,
+  bridge: Pick<typeof ipcBridge, 'assistants' | 'fs'> = ipcBridge
+): Promise<string> {
+  if (
+    !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(persona.slug) ||
+    persona.slug.length > 80 ||
+    !persona.name.trim() ||
+    !persona.body.trim()
+  ) {
+    throw new Error('Invalid Agency specialist');
+  }
+  const id = `agas-agency-${persona.slug}`;
+  const created = await bridge.assistants.create.invoke({
+    id,
+    name: persona.name,
+    description: persona.description,
+  });
+  try {
+    const saved = await bridge.fs.writeAssistantRule.invoke({
+      assistant_id: created.id,
+      locale: 'en-US',
+      content: persona.body,
+    });
+    if (!saved) throw new Error('AionCore did not save the Agency assistant rule');
+  } catch (error) {
+    try {
+      await bridge.assistants.delete.invoke({ id: created.id });
+    } catch (rollbackError) {
+      throw new AggregateError(
+        [error, rollbackError],
+        `Agency assistant ${created.id} was created but its rules could not be saved or rolled back`
+      );
+    }
+    throw error;
+  }
+  return created.id;
+}
